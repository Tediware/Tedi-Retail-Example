# Tediware integration. Copy to .env.local and fill in. Never commit .env.local.
#
# The app runs with none of these set: it serves seed data, outbound submissions
# are stubbed as accepted, and the webhook can be exercised locally with fixtures
# (only TEDIWARE_WEBHOOK_SECRET is needed for that). Set all of them to run
# against a live Tediware instance.

# Base URL of the Tediware API.
TEDIWARE_BASE_URL=https://tediware.com

# API key for the platform API (result fetch and outbound submission).
TEDIWARE_API_KEY=

# Secret used to verify inbound webhook signatures. For local webhook testing
# with the fixture harness, set this to any value and restart the app.
TEDIWARE_WEBHOOK_SECRET=

# Optional. Secrets for the outbound (delivered) and error webhooks, pointed at
# /api/webhooks/tediware/outbound and /api/webhooks/tediware/errors. Each
# Tediware webhook has its own secret; either one falls back to
# TEDIWARE_WEBHOOK_SECRET when unset.
# TEDIWARE_OUTBOUND_WEBHOOK_SECRET=
# TEDIWARE_ERROR_WEBHOOK_SECRET=

# Trading partner key used in outbound URLs (Petco).
TEDIWARE_PARTNER_KEY=

# Optional. Webhook replay tolerance in seconds (default 300).
# TEDIWARE_WEBHOOK_TOLERANCE_SECONDS=300
